# WoolGate 启动配置（修改后需重启服务）

# 服务监听配置
HOST=0.0.0.0
PORT=8765

# 数据存储路径
DATA_PATH=./data

# 日志配置
LOG_LEVEL=INFO

# API鉴权密钥（全局Bearer Token）
GATEWAY_BEARER_TOKEN=your-secret-token-here

# AES加密密钥（用于加密存储厂商API Key，32字节base64编码）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
